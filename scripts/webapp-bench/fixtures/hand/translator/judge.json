{
  "version": 1,
  "start": {
    "command": "node server.js",
    "port": "PORT",
    "data": "DATA_DIR",
    "env": { "SESSION_SECRET": "{secret}" },
    "secrets": ["SESSION_SECRET"],
    "browserFolders": ["public"]
  },
  "accounts": {
    "signUp": { "path": "/api/sign-up", "body": { "name": "{name}", "email": "{email}", "password": "{password}" } },
    "signIn": { "path": "/api/sign-in", "body": { "email": "{email}", "password": "{password}" } }
  },
  "home": "/home",
  "money": "units",
  "things": {
    "clients": {
      "list": { "path": "/api/clients", "rows": "rows" },
      "add": { "path": "/api/clients" },
      "one": { "path": "/api/clients/{id}", "read": "GET", "change": "PUT", "remove": "DELETE" },
      "fields": { "name": "name", "country": "country", "notes": "notes" }
    },
    "jobs": {
      "list": { "path": "/api/jobs", "rows": "rows" },
      "add": { "path": "/api/jobs" },
      "one": { "path": "/api/jobs/{id}", "read": "GET", "change": "PUT", "remove": "DELETE" },
      "fields": { "client": "clientId", "title": "title", "words": "words", "fee": "fee", "due": "due", "delivered on": "deliveredOn", "source file": "sourceFile" }
    }
  }
}
