#!/usr/bin/env node
import { main } from '../lib/sym/cli.mjs';

// `sym ... | head` closes the pipe early: that is not an error
process.stdout.on('error', (e) => { if (e.code === 'EPIPE') process.exit(0); throw e; });

main(process.argv.slice(2)).then((code) => { process.exitCode = code; }).catch((e) => {
  process.stderr.write(`sym: internal error: ${e && e.stack ? e.stack : e}\n`);
  process.exitCode = 3;
});
