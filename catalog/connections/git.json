{
  "$schema": "../schema.json",
  "id": "git",
  "name": "Git",
  "description": "Read the history, diffs and branches of git repositories on this computer, and commit.",
  "category": "local",
  "icon": "git",
  "color": "#F05032",
  "homepage": "https://github.com/modelcontextprotocol/servers",
  "docs": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
  "server": {
    "transport": "stdio",
    "command": "uvx",
