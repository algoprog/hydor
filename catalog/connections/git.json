  "auth": {
    "type": "none"
  },
  "keywords": [
    "version control",
    "commits",
    "branches",
    "diffs"
  ],
  "verified": {
    "by": "scripts/check-catalog.mjs --probe",
    "date": "2026-10-31"
  },
  "notes": "Needs uv (uvx) on this computer."
