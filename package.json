{
  "name": "agent-console",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted web app for Claude Code, Codex and other coding agents: run them on your own machine, follow their work live, approve what they ask and pick up on your phone.",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agents",
    "ai-agents",
    "agent-client-protocol",
    "self-hosted",
    "web-ui",
    "developer-tools",
    "anthropic",
    "openai",
    "pwa",
    "terminal",
    "remote-development"
  ],
  "homepage": "https://github.com/Naget-Inc/agent-console#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naget-Inc/agent-console.git"
  },
  "bugs": {
    "url": "https://github.com/Naget-Inc/agent-console/issues"
  },
  "author": "Naget, Inc.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:server && npm run build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server/index.js",
    "set-password": "node dist/server/cli.js set-password"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "11.3.3",
    "@openai/codex": "0.161.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "node-pty": "1.1.0",
    "ws": "8.22.0",
    "zeromq": "6.8.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "katex": "0.19.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wouter": "3.13.0",
    "zustand": "5.0.15"
  }
}
